# ─── LLM Provider ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key        # https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash
SLOW_LLM_MODEL=deepseek/deepseek-r1

# ─── Vector Database (Qdrant) ─────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=support_docs

# ─── Cache & Session Store (Redis) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ─── Reranker ─────────────────────────────────────────────────────────────────
COHERE_API_KEY=your_cohere_api_key                # https://dashboard.cohere.com/api-keys
RERANKER_MODEL=rerank-english-v3.0

# ─── Auth & Security ─────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_random_string
AUTH_ENABLED=true
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:8501"]

# ─── App Settings ─────────────────────────────────────────────────────────────
RATE_LIMIT_RPM=30
DATA_DIR=data/docs
ENABLE_GUARDRAILS=true

# ─── Observability (Optional) ────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key           # https://smith.langchain.com
LANGCHAIN_PROJECT=Support Docs Copilot
